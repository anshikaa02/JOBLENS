# Copy this file to .env and fill in your own key. Never commit .env.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — override the default model. See https://ai.google.dev/gemini-api/docs/models
# GEMINI_MODEL=gemini-3.6-flash

# REQUIRED before deploying anywhere (Phase 12) — signs login tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# The app runs fine without this for local dev (falls back to an insecure
# default with a startup warning), but never ship the default anywhere real.
JWT_SECRET=

# Optional — how long a login session lasts, in minutes. Default: 1440 (24h)
# JWT_EXPIRE_MINUTES=1440
